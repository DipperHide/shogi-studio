; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="将棋"
config/version="0.30.0"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.145, 0.094, 0.059, 1)
boot_splash/minimum_display_time=0
config/use_custom_user_dir=true
config/custom_user_dir_name="ShogiStudio"
config/icon="res://assets/brand/studio-icon.svg"
run/main_scene="res://minimal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=360
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/window_width_override=1100
window/size/window_height_override=800
window/size/min_width=280
window/size/min_height=280
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=true

[editor_plugins]

enabled=PackedStringArray("res://addons/shogi_platform/plugin.cfg")

[rendering]

environment/defaults/default_clear_color=Color(0.145, 0.094, 0.059, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3

lights_and_shadows/directional_shadow/size=4096
